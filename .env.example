# Generate with: openssl rand -base64 32
GATEWAY_MASTER_KEY=<base64-encoded-32-byte-key>

# Required only when the database does not contain an administrator.
GATEWAY_ADMIN_USERNAME=admin
GATEWAY_ADMIN_PASSWORD=<at-least-12-characters>

# Open the local management page in the system default browser after startup.
GATEWAY_OPEN_BROWSER=true
